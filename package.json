{
  "name": "language-learner",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev -p ${PORT:-4100}",
    "build": "next build",
    "start": "next start -p ${PORT:-4100}",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test --test-concurrency=1 tests/**/*.test.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node src/db/migrate.ts",
    "db:seed": "node src/db/seed.ts",
    "db:seed-content": "node src/content/seed-content.ts",
    "test:contract": "node --test tests/grader-contract.test.ts tests/semaphore.test.ts tests/smoke.test.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.237",
    "@mantine/core": "^9.6.0",
    "@mantine/hooks": "^9.6.0",
    "@node-rs/argon2": "^2.1.0",
    "better-sqlite3": "^12.11.1",
    "drizzle-orm": "^0.45.2",
    "next": "^16.3.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.7.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "drizzle-kit": "^0.31.0",
    "puppeteer-core": "^24.43.1",
    "typescript": "^5.9.0"
  }
}
